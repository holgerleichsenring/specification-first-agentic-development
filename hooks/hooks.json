{
  "description": "spec-first commit gate: runs the project's verify stages on every spec commit and blocks it on a red stage.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/spec-gate.py\"",
            "timeout": 1800
          }
        ]
      }
    ]
  }
}
